{
  "id": "hw9-follow-user-jml-fill",
  "title": "用 JML 描述双向关注关系",
  "method": "followUser",
  "semantic_suite": "../judge-2027/unit3/spec_judge/suites/NetworkInterface/followUser/suite.yaml",
  "allowed_modes": ["hint", "review"],
  "default_mode": "hint",
  "feedback_contract": {
    "hint": {
      "level": "guided",
      "reveals": ["one highest-priority category", "one direct repair direction"],
      "never_reveals": ["replacement clause", "reference JML", "state snapshot", "hidden mutations"]
    },
    "review": {
      "level": "detailed",
      "reveals": ["blank location", "category", "abstract counterexample shape", "repair direction"],
      "never_reveals": ["replacement clause", "reference JML", "complete state", "hidden mutations"]
    }
  },
  "samples": [
    {"id": "missing-normal", "label": "错误：正常条件遗漏", "file": "samples/missing-normal-condition.java"},
    {"id": "wrong-direction", "label": "错误：关系方向颠倒", "file": "samples/wrong-relation-direction.java"},
    {"id": "overlap-exception", "label": "错误：异常条件重叠", "file": "samples/overlapping-exceptions.java"},
    {"id": "hallucinated-symbol", "label": "错误：使用不存在接口", "file": "samples/hallucinated-symbol.java"},
    {"id": "unfinished", "label": "错误：仍有空格", "file": "samples/incomplete.java"}
  ],
  "placeholders": [
    "NORMAL_CONDITION",
    "FORWARD_POSTCONDITION",
    "INVERSE_POSTCONDITION",
    "FIRST_USER_MISSING",
    "SECOND_USER_MISSING",
    "SELF_FOLLOW",
    "DUPLICATE_FOLLOW"
  ],
  "allowed_symbols": [
    "containsUser", "getUser", "isFollowing", "containsFollower", "users",
    "UserIdNotFoundException", "SelfSubscriptionException", "DuplicateSubscriptionException"
  ],
  "consistency_demo_cases": [
    {
      "id": "all-correct",
      "label": "案例 A：规格正确，代码正确",
      "description": "两条一致性链均应通过。",
      "jml_excerpt": "ensures getUser(id1).isFollowing(getUser(id2));\nensures getUser(id2).containsFollower(getUser(id1));",
      "java_excerpt": "fun.addFollowing(star);\nstar.addFollower(fun);",
      "expected": "C1 PASS · C2 PASS",
      "student_jml": "staff/fixtures/follow_user_complete.java",
      "implementation_method": "followUser"
    },
    {
      "id": "wrong-spec",
      "label": "案例 B：规格方向写反，但代码满足该规格",
      "description": "展示为什么不能只检查 Java 是否满足学生自己的 JML。",
      "jml_excerpt": "ensures getUser(id2).isFollowing(getUser(id1));\nensures getUser(id1).containsFollower(getUser(id2));",
      "java_excerpt": "star.addFollowing(fun);\nfun.addFollower(star);",
      "expected": "C1 FAIL · C2 PASS",
      "student_jml": "exercises/follow_user/samples/wrong-relation-direction.java",
      "implementation_method": "followUserWrongSpec"
    },
    {
      "id": "wrong-code",
      "label": "案例 C：规格正确，但代码漏更新粉丝关系",
      "description": "NL–JML 通过，OpenJML 应报告后置条件失败。",
      "jml_excerpt": "ensures getUser(id1).isFollowing(getUser(id2));\nensures getUser(id2).containsFollower(getUser(id1));",
      "java_excerpt": "fun.addFollowing(star);\n// 缺少 star.addFollower(fun);",
      "expected": "C1 PASS · C2 FAIL",
      "student_jml": "staff/fixtures/follow_user_complete.java",
      "implementation_method": "followUserBroken"
    }
  ]
}
